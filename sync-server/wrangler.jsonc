{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memnoter-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "VAULT", "class_name": "Vault" },
      { "name": "ACCOUNT", "class_name": "Account" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault", "Account"] }],
  // Create once with `npx wrangler r2 bucket create memnoter-sync`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "memnoter-sync" }],
  // Sign-in requests per IP address.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // The from address's domain must be onboarded first:
  // `npx wrangler email sending enable <domain>`.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "sync@memnoter.app"
  }
  // AUTH_SECRET is a secret: `npx wrangler secret put AUTH_SECRET`.
  // For local development put AUTH_SECRET and DEV_RETURN_CODE=1 in .dev.vars.
}
