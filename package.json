{
  "name": "memnoter",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "license": "MIT",
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:copy": "./scripts/dev-copy.sh",
    "dev:ui": "pnpm --filter memnoter-shared-ui dev",
    "dev:sync": "./scripts/ensure-sync-vars.sh && pnpm --filter memnoter-sync dev",
    "dev:sync-test": "./scripts/sync-dev.sh",
    "dev:marketing": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)} node apps/marketing/build.mjs && pnpm --filter memnoter-marketing preview",
    "dev:ios": "./scripts/build-ios-core.sh && ./scripts/build-ios-web.sh && cd apps/ios && xcodegen generate && open Memnoter.xcodeproj",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm --filter memnoter-sync test && cargo test --workspace",
    "test": "pnpm --filter memnoter-shared-ui test",
    "lint": "node scripts/lint-style.mjs",
    "build": "pnpm --filter memnoter-shared-ui build",
    "preview": "pnpm --filter memnoter-shared-ui preview",
    "tauri": "tauri",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs",
    "check:ci": "./scripts/check-ci.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "postcss": "^8.5.6"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tanstack/history@1.162.0": "patches/@tanstack__history@1.162.0.patch",
      "@tiptap/y-tiptap@3.0.6": "patches/@tiptap__y-tiptap@3.0.6.patch"
    }
  }
}
