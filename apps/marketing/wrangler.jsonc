{
  "name": "memnoter-website",
  "account_id": "2ebb0c0a3055bf941210dc29d1e53ca2",
  "compatibility_date": "2026-10-01",
  // Run `node apps/marketing/build.mjs` first. The Worker only touches HTML pages,
  // keeping download links on the latest release between deploys.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "memnoter.com", "custom_domain": true },
    { "pattern": "www.memnoter.com", "custom_domain": true }
  ]
}
