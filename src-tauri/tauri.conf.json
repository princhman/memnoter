{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memnoter",
  "version": "0.1.0",
  "identifier": "com.vladyslavnalyvaiko.memnoter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memnoter",
        "width": 800,
        "height": 600,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**/*",
          "$RESOURCE/**/*",
          "$APPDATA/files/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMDZERjgxOThBMTgwODEKUldTQmdLR1lnZDhHWFJuOU93UmtYZFZwbU9XOXZ3dCtJNFRiMnlDZ05za242ZTdjbEo5WXF3aTYK",
      "endpoints": [
        "https://github.com/princhman/memnoter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
