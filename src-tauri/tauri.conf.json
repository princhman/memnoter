{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notes",
  "version": "0.1.0",
  "identifier": "com.vladyslavnalyvaiko.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "notes",
        "width": 800,
        "height": 600,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
          "enable": true,
          "scope": ["$APPCACHE/**/*", "$RESOURCE/**/*", "$APPDATA/files/**"]
        }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
